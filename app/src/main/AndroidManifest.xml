<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Screenshot detection via MediaStore (Android 13+ uses READ_MEDIA_IMAGES) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Optional brightness slider; user grants special access in system settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Таймер острова будит телефон к своему окончанию, даже если экран погашен -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- …и включает экран, когда звонит -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Звонки: состояние вызова, номер, имя из контактов, ответ и сброс -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- «Не выгружать остров»: служба на переднем плане, чтобы остров не закрывался вместе с недавними -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Root mode of «Hide in selected apps»: restore the island after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Кнопки «Режим звука» и «Не беспокоить» в раскрытом острове -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Иконки и запуск приложений, которые показывают музыку и прогресс -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Приложения «Часы» для экрана «Системные плашки» -->
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- Будильник в острове — только от приложений-будильников, а не от календарей и напоминалок -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- Приложения, которые умеют платить телефоном по NFC: только на их экране остров ждёт оплату -->
        <intent>
            <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".IslandApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Island">

        <!-- Optional LSPosed module (scope: System UI): hides status-bar icons under the island and
             reports fullscreen / shade state. The island works without it. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Dynamic Island helper for System UI: hides status-bar icons under the island, detects fullscreen apps and the notification shade" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SystemAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Island" />

        <!-- Hide only this alias. MainActivity remains enabled for the tile and Android settings. -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- «Поставь таймер» от помощника или виджета: если выбрать остров, таймер сразу в нём.
         Как у «Часов» Android: позвать его могут только приложения с правом ставить будильники и таймеры -->
        <activity
            android:name=".ui.SetTimerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Пустой прозрачный экран: включает дисплей, когда звонит таймер, если не вышло иначе -->
        <activity
            android:name=".service.WakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Рисует остров поверх строки состояния -->
        <service
            android:name=".service.IslandService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- «Не выгружать остров»: тихое уведомление держит процесс острова, когда приложение смахивают из недавних -->
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the Dynamic Island accessibility overlay running when the app is removed from recent apps" />
        </service>

        <receiver
            android:name=".service.BankGuardBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- «Восстановить остров» из уведомления Keep Alive: пересобрать окна или открыть спец. возможности -->
        <receiver
            android:name=".service.RestoreIslandReceiver"
            android:exported="false" />

        <!-- Root mode of «Hide in selected apps»: watches which app opens, switches the accessibility service
             off while a chosen app (e.g. a banking app) is open and back on afterwards. Needs root. -->
        <service
            android:name=".service.BankGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches foreground app changes to turn the Dynamic Island accessibility service off while selected apps are open" />
        </service>

        <!-- Плитка «Остров» в шторке: выключить на время банковского приложения и включить обратно.
         Привязаться к ней может только система (BIND_QUICK_SETTINGS_TILE) -->
        <service
            android:name=".service.IslandTile"
            android:exported="true"
            android:icon="@drawable/ic_tab_island"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Музыка, прогресс и таймеры из уведомлений других приложений -->
        <service
            android:name=".service.NotifListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
